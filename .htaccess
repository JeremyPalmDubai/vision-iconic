DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Canonical host; activate SSL for the selected domain in Hostinger.
RewriteCond %{HTTP_HOST} ^www\.vision-iconic-residences\.com$ [NC]
RewriteRule ^ https://vision-iconic-residences.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^vision-iconic-residences\.com$ [NC]
RewriteRule ^ https://vision-iconic-residences.com%{REQUEST_URI} [R=301,L]
# One canonical English entry point.
RewriteRule ^$ /en/invest-in-dubai/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
<FilesMatch "\.(webp|png|jpg|svg)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
